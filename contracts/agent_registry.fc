#include "imports/stdlib.fc";

;; ===== Agent Registry (NFT Collection - TEP-62) =====
;; KYA (Know Your Agent) Registry: issues SBT identity for AI Agents

;; Storage: owner_address, next_item_index, content, agent_sbt_code
(slice, int, cell, cell) load_data() inline {
    var ds = get_data().begin_parse();
    return (
        ds~load_msg_addr(),   ;; owner_address
        ds~load_uint(64),     ;; next_item_index
        ds~load_ref(),        ;; content (collection metadata)
        ds~load_ref()         ;; agent_sbt_code
    );
}

() save_data(slice owner_address, int next_item_index, cell content, cell agent_sbt_code) impure inline {
    set_data(begin_cell()
        .store_slice(owner_address)
        .store_uint(next_item_index, 64)
        .store_ref(content)
        .store_ref(agent_sbt_code)
    .end_cell());
}

cell calculate_agent_sbt_state_init(int item_index, cell agent_sbt_code) inline {
    ;; SBT init data: index, collection_address
    cell data = begin_cell()
        .store_uint(item_index, 64)
        .store_slice(my_address())
    .end_cell();
    return begin_cell()
        .store_uint(0, 2)   ;; split_depth + special
        .store_dict(agent_sbt_code) ;; code
        .store_dict(data)           ;; data
        .store_uint(0, 1)   ;; library
    .end_cell();
}

slice calculate_nft_item_address(int wc, cell state_init) inline {
    return begin_cell()
        .store_uint(4, 3)            ;; addr_std$10 + anycast = 0
        .store_int(wc, 8)
        .store_uint(cell_hash(state_init), 256)
    .end_cell().begin_parse();
}

() deploy_agent_sbt(int item_index, cell agent_sbt_code, int amount, cell agent_content, slice owner) impure {
    cell state_init = calculate_agent_sbt_state_init(item_index, agent_sbt_code);
    slice sbt_address = calculate_nft_item_address(0, state_init);

    ;; Message body: owner_address + content
    cell body = begin_cell()
        .store_slice(owner)
        .store_ref(agent_content)
    .end_cell();

    var msg = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(sbt_address)
        .store_coins(amount)
        .store_uint(4 + 2 + 1, 1 + 4 + 4 + 64 + 32 + 1 + 1 + 1)
        .store_ref(state_init)
        .store_ref(body);

    send_raw_message(msg.end_cell(), 1); ;; pay fees separately
}

;; ===== Internal messages =====

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) { return (); }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) { return (); } ;; bounced

    slice sender_address = cs~load_msg_addr();
    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    var (owner_address, next_item_index, content, agent_sbt_code) = load_data();

    ;; op::mint_agent = 0x1
    if (op == 1) {
        throw_unless(401, equal_slices(sender_address, owner_address)); ;; owner only

        int item_index = in_msg_body~load_uint(64);
        throw_unless(402, item_index <= next_item_index); ;; sequential only

        int amount = in_msg_body~load_coins();
        cell agent_content = in_msg_body~load_ref();
        slice agent_owner = in_msg_body~load_msg_addr();

        deploy_agent_sbt(item_index, agent_sbt_code, amount, agent_content, agent_owner);

        save_data(owner_address, next_item_index + 1, content, agent_sbt_code);
        return ();
    }

    ;; op::register_self = 0x2
    ;; Permissionless self-registration: caller becomes SBT owner
    ;; This provides cryptographic wallet proof — the sender's signature
    ;; on this transaction proves they control the wallet address.
    if (op == 2) {
        int amount = in_msg_body~load_coins();
        cell agent_content = in_msg_body~load_ref();

        ;; sender_address IS the agent owner — cryptographic proof via TX signature
        deploy_agent_sbt(next_item_index, agent_sbt_code, amount, agent_content, sender_address);

        save_data(owner_address, next_item_index + 1, content, agent_sbt_code);
        return ();
    }

    ;; op::change_owner = 0x3
    if (op == 3) {
        throw_unless(401, equal_slices(sender_address, owner_address));
        slice new_owner = in_msg_body~load_msg_addr();
        save_data(new_owner, next_item_index, content, agent_sbt_code);
        return ();
    }

    throw(0xffff); ;; unknown op
}

;; ===== Get methods =====

(int, cell, slice) get_collection_data() method_id {
    var (owner_address, next_item_index, content, _) = load_data();
    return (next_item_index, content, owner_address);
}

slice get_nft_address_by_index(int index) method_id {
    var (_, _, _, agent_sbt_code) = load_data();
    cell state_init = calculate_agent_sbt_state_init(index, agent_sbt_code);
    return calculate_nft_item_address(0, state_init);
}

cell get_nft_content(int index, cell individual_content) method_id {
    ;; For on-chain SBTs, individual content is the full content
    return individual_content;
}
